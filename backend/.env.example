# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_NAME=LARA Shipping Backend

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/lara_shipping

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Local Dev Auth (used when Supabase is not configured) ──
LOCAL_JWT_SECRET=lara-dev-secret-change-in-production
LOCAL_JWT_ALGORITHM=HS256
LOCAL_JWT_EXPIRE_MINUTES=60

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── File Uploads ────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
SUPABASE_STORAGE_BUCKET=shipment-documents

# ── External Services (future) ──────────────────────────────
SENTRY_DSN=
REDIS_URL=
EMAIL_PROVIDER=
EMAIL_API_KEY=
